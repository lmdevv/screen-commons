{
  "name": "@screen-commons/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "screen-commons-mcp: stdio MCP server for Screen Commons (catalog tools + browser capture via the extension bridge or headless Chromium).",
  "license": "Apache-2.0",
  "bin": {
    "screen-commons-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@screen-commons/capture": "workspace:*",
    "@screen-commons/config": "workspace:*",
    "@screen-commons/core": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
