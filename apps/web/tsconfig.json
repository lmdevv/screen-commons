{
  "extends": "@screen-commons/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true,
    // e2e/*.ts run under Node type stripping, which needs the .ts in relative imports.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "tests", "e2e", "vite.config.ts", "vitest.config.ts"]
}
