{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Existing resource names are retained so the rebrand preserves deployments and data.
  "name": "open-ui",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-ui",
      // Replace with your D1 database id (`wrangler d1 create open-ui`) before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "open-ui-media" }],
  // Server-side thumbnails when a client can't send one (e.g. remote MCP upload_screen).
  "images": { "binding": "IMAGES" },
  "vars": {
    "APP_URL": "http://localhost:5173",
  },
}
