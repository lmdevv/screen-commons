{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "screen-commons",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // Per-version preview URLs (`wrangler versions upload --preview-alias`); CI uses them on `dev`.
  "preview_urls": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "screen-commons",
      // Self-hosting: replace with your own id from `wrangler d1 create screen-commons`.
      "database_id": "96207939-3a56-4fba-a2c4-841405a0782a",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "screen-commons-media" }],
  // Server-side thumbnails when a client can't send one (e.g. remote MCP upload_screen).
  "images": { "binding": "IMAGES" },
  "vars": {
    // Public origin. `.dev.vars` overrides it locally (see .dev.vars.example).
    "APP_URL": "https://screen-commons.lmdev.workers.dev",
  },
  "env": {
    // Shared non-production environment: tracks `main`, and every pull request uploads a preview
    // version of it (https://pr-<number>-screen-commons-dev.<subdomain>.workers.dev). Bindings
    // aren't inherited, so each one is repeated against its own dev resources.
    "dev": {
      "name": "screen-commons-dev",
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "screen-commons-dev",
          "database_id": "68564e79-c752-4628-b4de-6531bcdac4d1",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "screen-commons-media-dev" }],
      "images": { "binding": "IMAGES" },
      "vars": {
        // Previews override this per version with `--var APP_URL:<preview url>`.
        "APP_URL": "https://screen-commons-dev.lmdev.workers.dev",
      },
    },
  },
}
