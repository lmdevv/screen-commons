{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src",
    "e2e",
    "wxt.config.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts"
  ]
}
